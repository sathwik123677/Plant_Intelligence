# Copy this file to .env and fill in your own values.

# Required — get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key

# Optional — only needed for the "Graph Insights" panel (GraphRAG demo).
# The app runs fully without these; the panel just shows an "unavailable" state.
# Get a free instance at https://console.neo4j.io
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
